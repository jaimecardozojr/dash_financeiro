# =============================================================================
# MODELO de secrets. Copie para "secrets.toml" e preencha com seus dados reais.
# O secrets.toml REAL nunca vai para o GitHub (esta no .gitignore).
# No Streamlit Cloud, cole este conteudo (ja preenchido) em Settings > Secrets.
# =============================================================================

# ID da planilha (trecho da URL entre /d/ e /edit)
sheet_id = "COLE_AQUI_O_ID_DA_PLANILHA"

# Credenciais da conta de servico do Google (arquivo JSON)
[gcp_service_account]
type = "service_account"
project_id = "seu-projeto"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "conta@seu-projeto.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
universe_domain = "googleapis.com"

# (opcional) chave para assinar o cookie de "lembrar login". Se nao definir, o app
# deriva uma chave estavel da conta de servico. Em producao, prefira definir:
cookie_secret = "troque-por-uma-frase-aleatoria-bem-grande"

# Usuarios que podem entrar no dashboard (usuario = "senha"). Use senhas fortes.
[credenciais]
jaime = "troque-esta-senha"
financeiro = "outra-senha-forte"
